# ============================================================
# Gateflow .gitignore — build artifacts, secrets, editor state,
# and ALL AI-agent session/state files. Agent instruction docs
# (AGENTS.md, CLAUDE.md) stay tracked; everything an agent
# *generates locally* (sessions, transcripts, caches) must not.
# A CI job (lint-tracked-files) enforces this on every push.
# ============================================================

# ---------- AI coding agents: local state, sessions, caches ----------
# OpenCode
.opencode/
opencode.json
opencode.jsonc
# Claude Code
.claude/
.claude.json
claude-debug.log
# Cursor
.cursor/
.cursor-index/
# GitHub Copilot
.copilot/
# Aider
.aider*
# Continue dev
.continue/
# Codex CLI
.codex/
# Gemini CLI
.gemini/
# Warp / Windsurf / Zed / generic
.warp/
.windsurf/
.zed/
.chat-history/
*session*.jsonl
*transcript*.json*
agent-*.log

# ---------- Secrets & local env (never commit) ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*credentials*.json
*secret*.json
secrets/

# ---------- Rust ----------
target/
**/*.rs.bk
cargo-test-coverage/
lcov.info

# ---------- Node / Next.js ----------
node_modules/
.next/
out/
dist/
build/
coverage/
.nyc_output/
*.tsbuildinfo
.turbo/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- SQLite (local dev databases) ----------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---------- Logs & temp ----------
logs/
*.log
tmp/
temp/
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.swo
*.orig
*.rej

# ---------- Editors / IDEs (local settings) ----------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.vim/
